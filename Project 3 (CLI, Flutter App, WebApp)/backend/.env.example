# ============================================
# NSU Degree Audit - Environment Configuration
# ============================================
# Copy this to .env and fill in your actual values
# NEVER commit .env with real secrets!

# === REQUIRED - App will fail to start without these ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET_KEY=generate_a_32_char_random_string

# === OCR APIs (at least one required for OCR functionality) ===
# Google Cloud Vision - 1000 free requests/month
GOOGLE_VISION_API_KEY=your_google_cloud_vision_key

# OCR.space - 500 free requests/month  
OCR_SPACE_API_KEY=your_ocr_space_key

# === OPTIONAL CONFIGURATION ===

# CORS Origins (JSON array format)
# CORS_ORIGINS=["https://ocr.nsunexus.app","http://localhost:3000"]

# Rate Limiting (requests per minute per IP)
# RATE_LIMIT_PER_MINUTE=30

# File Upload
# MAX_UPLOAD_SIZE_MB=16

# Logging
# LOG_LEVEL=INFO
# DEBUG=false

# Google OAuth Client ID (for frontend OAuth)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
