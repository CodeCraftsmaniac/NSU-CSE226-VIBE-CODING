# ============================================
# NSU Degree Audit - Environment Configuration
# ============================================
# Copy this file to .env and configure your settings
# IMPORTANT: Never commit .env with real API keys to version control!

# ============================================
# Server Configuration
# ============================================
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# File Upload
MAX_CONTENT_LENGTH_MB=16
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# ============================================
# Database - Supabase (REQUIRED)
# ============================================
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================
# OCR API Keys (REQUIRED - at least one)
# ============================================
# At least one OCR API key is required for scanned PDF processing.
# Digital PDFs can be processed without API keys (native text extraction).

# OCR.space API (Primary - easier to set up)
# Get your FREE key at: https://ocr.space/ocrapi/freekey
# Free tier: 500 requests/month
OCR_SPACE_API_KEY=your-ocr-space-api-key

# Google Cloud Vision API (Recommended - more accurate)
# Setup: https://console.cloud.google.com/
# 1. Create project -> Enable Cloud Vision API
# 2. Create API key (restrict to Vision API for security)
# Free tier: 1000 requests/month
GOOGLE_CLOUD_VISION_KEY=your-google-vision-api-key

# ============================================
# Google OAuth (REQUIRED for Google Sign-In)
# ============================================
# Get from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated list of allowed origins
# Default allows production domains + localhost
# CORS_ORIGINS=https://ocr.nsunexus.app,https://ocrapi.nsunexus.app,http://localhost:5000
