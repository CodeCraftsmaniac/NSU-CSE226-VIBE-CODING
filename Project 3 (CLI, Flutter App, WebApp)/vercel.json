{
  "version": 2,
  "builds": [
    {
      "src": "web_app/app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "web_app/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/web_app/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web_app/app.py"
    }
  ]
}
